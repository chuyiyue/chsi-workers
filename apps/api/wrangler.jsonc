{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xuexin-demo",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "kv_namespaces": [
    { "binding": "KV", "id": "REPLACE_WITH_KV_ID" }
  ],
  "vars": {
    "VERSION": "v2-refactor"
  },
  "assets": {
    "directory": "../web/public"
  },
  "env": {
    "staging": {
      "vars": { "VERSION": "staging" }
    },
    "prod": {
      "vars": { "VERSION": "prod" }
    }
  }
}
